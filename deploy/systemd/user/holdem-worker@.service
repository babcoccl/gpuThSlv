# Engine worker for one GPU (%i), Python 3.9. Install: deploy/install-user-units.sh
[Unit]
Description=holdem-solver engine worker (GPU %i)
PartOf=holdem-solver.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=@REPO@
EnvironmentFile=%h/.config/holdem-solver/holdem.env
Environment=PYTHONPATH=@REPO@ PYTHONDONTWRITEBYTECODE=1 CUDA_VISIBLE_DEVICES=%i
Environment=HOLDEM_SOLVER_RUNTIME_DIR=%t/holdem-solver
# No --parent-pid: systemd supervises this process, not the API.
ExecStart=@REPO@/.venv-engine/bin/python -m holdem_solver.engine_worker --engine real --gpu %i
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0077
StandardOutput=append:@LOGDIR@/worker-gpu%i.log
StandardError=inherit

[Install]
WantedBy=holdem-solver.target

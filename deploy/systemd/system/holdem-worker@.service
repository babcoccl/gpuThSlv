# System-wide variant (needs root to install). Assumes a `holdem` user, the
# repo at /opt/holdem-solver with both venvs built, and /etc/holdem-solver/holdem.env.
[Unit]
Description=holdem-solver engine worker (GPU %i)
PartOf=holdem-solver.target
After=nvidia-persistenced.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=holdem
Group=holdem
SupplementaryGroups=video render
WorkingDirectory=/opt/holdem-solver
EnvironmentFile=/etc/holdem-solver/holdem.env
Environment=PYTHONPATH=/opt/holdem-solver PYTHONDONTWRITEBYTECODE=1 CUDA_VISIBLE_DEVICES=%i
Environment=HOLDEM_SOLVER_RUNTIME_DIR=/run/holdem-solver
RuntimeDirectory=holdem-solver
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/opt/holdem-solver/.venv-engine/bin/python -m holdem_solver.engine_worker --engine real --gpu %i
Restart=always
RestartSec=2
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Logs go to the journal (rotated by journald): journalctl -u <unit>.
StandardOutput=journal
StandardError=inherit

[Install]
WantedBy=holdem-solver.target

# holdem-release-unit prefix=@PREFIX@ (rendered by scripts/release/install.sh)
# One instance per GPU: `systemctl start holdem-worker@0 holdem-worker@1`.
# The GPU is chosen by the instance name (%i) via CUDA_VISIBLE_DEVICES.
[Unit]
Description=holdem-solver engine worker (GPU %i)
PartOf=holdem-solver.target
After=nvidia-persistenced.service
Wants=nvidia-persistenced.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=@USER@
Group=@GROUP@
SupplementaryGroups=video render
WorkingDirectory=@PREFIX@/current
EnvironmentFile=@CONFDIR@/holdem.env
Environment=PYTHONPATH=@PREFIX@/current PYTHONDONTWRITEBYTECODE=1 CUDA_VISIBLE_DEVICES=%i
Environment=HOLDEM_SOLVER_RUNTIME_DIR=@RUNDIR@
RuntimeDirectory=@RUNNAME@
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=@PREFIX@/current/.venv-engine/bin/python -m holdem_solver.engine_worker --engine ${HOLDEM_SOLVER_ENGINE} --gpu %i
Restart=always
RestartSec=2
# Graceful shutdown: the worker finishes the current RPC then exits.
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=@DATADIR@ @RUNDIR@
StandardOutput=journal
StandardError=inherit

[Install]
WantedBy=holdem-solver.target

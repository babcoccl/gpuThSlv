# System-wide unit (installed by scripts/release/install.sh; needs root).
# Assumes: `holdem` user, release tree at @PREFIX@/current with both venvs
# built, @CONFDIR@/holdem.env (0600, root), @DATADIR@ data dir.
[Unit]
Description=holdem-solver REST API
PartOf=holdem-solver.target
Wants=network-online.target holdem-worker@0.service holdem-worker@1.service
After=network-online.target holdem-worker@0.service holdem-worker@1.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@PREFIX@/current
EnvironmentFile=@CONFDIR@/holdem.env
Environment=PYTHONPATH=@PREFIX@/current HOLDEM_API_DATA_DIR=@DATADIR@
Environment=HOLDEM_SOLVER_RUNTIME_DIR=@RUNDIR@
RuntimeDirectory=@RUNNAME@
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=@STATENAME@
StateDirectoryMode=0700
ExecStart=@PREFIX@/current/.venv-api/bin/python -m holdem_solver.api
Restart=always
RestartSec=2
# Graceful shutdown: uvicorn finishes in-flight requests, workers are
# external so their CUDA contexts survive an API restart.
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=@DATADIR@ @RUNDIR@
# Logs go to the journal (rotated by journald): journalctl -u holdem-api.
StandardOutput=journal
StandardError=inherit

[Install]
WantedBy=holdem-solver.target

[Unit]
Description=holdem-solver REST API
PartOf=holdem-solver.target
Wants=network-online.target holdem-worker@0.service holdem-worker@1.service
After=network-online.target holdem-worker@0.service holdem-worker@1.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=holdem
Group=holdem
WorkingDirectory=/opt/holdem-solver
EnvironmentFile=/etc/holdem-solver/holdem.env
Environment=PYTHONPATH=/opt/holdem-solver HOLDEM_API_DATA_DIR=/var/lib/holdem-solver
Environment=HOLDEM_SOLVER_RUNTIME_DIR=/run/holdem-solver
RuntimeDirectory=holdem-solver
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=holdem-solver
StateDirectoryMode=0700
ExecStart=/opt/holdem-solver/.venv-api/bin/python -m holdem_solver.api
Restart=always
RestartSec=2
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/log/holdem-solver
StandardOutput=append:/var/log/holdem-solver/api.log
StandardError=inherit

[Install]
WantedBy=holdem-solver.target

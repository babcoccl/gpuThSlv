# holdem-solver environment. Copy to ~/.config/holdem-solver/holdem.env
# (user units) or /etc/holdem-solver/holdem.env (system units), mode 0600:
# it holds the API key.

# Required in production: bearer key for every endpoint except /healthz.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HOLDEM_API_KEY=change-me

HOLDEM_API_HOST=127.0.0.1
HOLDEM_API_PORT=8000
HOLDEM_GPUS=0,1
# external = attach to the holdem-worker@N units; spawn = API starts its own workers.
HOLDEM_WORKER_MODE=external
HOLDEM_SOLVER_ENGINE=real

# Limits
HOLDEM_MAX_QUEUE_DEPTH=64
HOLDEM_MAX_BODY_BYTES=65536
HOLDEM_POST_RATE_PER_MINUTE=120
HOLDEM_POST_BURST=30
HOLDEM_API_MAX_VRAM_BYTES=15032385536
HOLDEM_VRAM_RESERVE_BYTES=536870912
# Per-job wall-clock default (seconds); empty = none.
HOLDEM_JOB_TIMEOUT_SECONDS=3600

# Watchdog
HOLDEM_HEARTBEAT_SECONDS=5
HOLDEM_HUNG_WORKER_SECONDS=120
HOLDEM_CANCEL_GRACE_SECONDS=30

# Strategy files are deleted this long after the job finishes (7 days).
HOLDEM_STRATEGY_RETENTION_SECONDS=604800
HOLDEM_API_LOG_LEVEL=INFO
